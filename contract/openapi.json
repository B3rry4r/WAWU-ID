  "info": {
    "title": "WAWU ID",
    "description": "The sign-in service: the routes the mobile app calls.\n\nEvery success body is `{ data: ... }`, exactly as described here (no\ninterceptor). Every error body is ErrorBody. Generated from the code by\n`npm run contract:build`; never edited by hand.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "wawu-id": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "minLength": 7,
            "maxLength": 25,
            "description": "As typed: 0803..., +234... or 234..."
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "occupation": {
            "type": "string",
            "maxLength": 120
          },
          "accountType": {
            "type": "string",
