          "Auth",
          "app"
        ]
      }
    },
    "/auth/phone/verify/confirm": {
      "post": {
        "operationId": "phoneVerifyConfirm",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PhoneVerifyConfirmDto"
