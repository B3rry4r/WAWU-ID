// WAWU ID — Prisma schema
// Unified identity + auth service for the WAWUAfrica ecosystem.
// wawu_users schema derived from the Master Build Brief, Section 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// LEGACY. Superseded by the two-tick model: the four `*_verified_at` /
/// `*_verified_until` columns on WawuUser, derived through
/// `deriveVerification()` in src/common/verification.util.ts.
///
/// The enum and its column stay on the row deliberately. Dropping a column a
/// still-running older instance selects is how a deploy takes production down,
/// so this is the expand half of expand/contract: the new columns are written
/// and read, `verification_tier` is written only by the legacy internal route
/// and read by nothing. The drop is a separate migration once no deployed
/// instance selects it.
enum VerificationTier {
  basic
  verified_user
  verified_business
  certified_professional
  trusted_partner
  official
}

enum UserStatus {
  active
  suspended
  banned
  pending_deletion
}

model WawuUser {
  id               String           @id @default(uuid()) @db.Uuid
  // Nullable: phone-OTP-first signups (e.g. WAWUBasket flow) have no email/name yet.
  email            String?          @unique
  phone            String           @unique
  firstName        String?          @map("first_name")
  /// Optional, and its own column rather than part of the surname.
  ///
  /// Sign-up used to take one "Full name" box and split it on the first
  /// space, so "Excel Patrick Obi" was stored with lastName "Patrick Obi".
  /// That is not a spelling preference: KYC is a manual review against a
  /// government ID, and a surname carrying a middle name does not match the
  /// document it is checked against.
  middleName       String?          @map("middle_name")
  lastName         String?          @map("last_name")
  // Nullable: legacy users have no gender. Canonical lowercase 'male'|'female'.
  gender           String?
  country          String?
  state            String?
  // Nullable: OTP-only and Category B (onboarding-only) users have no password yet.
  passwordHash     String?          @map("password_hash")
  /// LEGACY, still written by PATCH /internal/users/:userId/verification-tier
  /// and still carried on the wire so an older Hub keeps parsing a login
  /// response. Read `verification` instead. See VerificationTier's comment.
  verificationTier VerificationTier @default(basic) @map("verification_tier")
  /// LEGACY. Trust Score is gone as a product surface; the column stays for
  /// the same expand/contract reason as verificationTier.
  trustScore       Int              @default(0) @map("trust_score")

  // ── The two ticks ─────────────────────────────────────────────────────────
  //
  // Two INDEPENDENT annual verifications, because one person can be both a
  // creator and a professional. Purple tick: creator, NGN 4,999/year. Green
  // tick: professional, NGN 9,999/year. Prices are the Hub's to hold, not
  // this service's -- WAWU ID stores only who holds what, and until when.
  //
  // There is no `verified` boolean on purpose. Whether a tick draws is
  // derived from the expiry by deriveVerification() in
  // src/common/verification.util.ts, server-side, every read. A stored
  // boolean is a boolean that goes stale the minute an expiry passes.
  //
  // `*VerifiedUntil` NULL while `*VerifiedAt` is set = perpetual, admin
  // granted. That is what the backfill from the old ladder produces.
  creatorVerifiedAt         DateTime? @map("creator_verified_at")
  creatorVerifiedUntil      DateTime? @map("creator_verified_until")
  professionalVerifiedAt    DateTime? @map("professional_verified_at")
  professionalVerifiedUntil DateTime? @map("professional_verified_until")
  status           UserStatus       @default(active)
  // Confirms the caller received a real code at this address. register()
  // still issues a session immediately (unchanged "active from creation"
  // design -- status stays 'active' throughout), but AuthService.login()
  // DOES gate on this for accounts that have an email: unverified means no
  // new session via /auth/login. Rows that existed before this gate went
  // live were backfilled to true (see migration
  // 20260816020000_backfill_email_verified_for_existing_users) so it only
  // blocks genuinely new, never-verified signups. See EmailVerificationCode.
  emailVerified    Boolean          @default(false) @map("email_verified")

  // Set when the owner of `phone` entered the code we sent to it (mobile
  // sign-up, POST /auth/phone/verify/confirm). NULL for every row that existed
  // before this column, and for any account that has not proven its phone.
  // AuthService.login() lets a phone-verified account in without a verified
  // email; an account with this NULL is judged exactly as before.
  phoneVerifiedAt  DateTime?        @map("phone_verified_at")
  // The number `phone_verified_at` was set FOR: the one the sign-up code was
  // texted to. The token says `phoneVerified` only while this is still the
  // account's `phone`, so a number written later by the internal phone-change
  // routes (which prove the mailbox, not the number, and leave
  // `phone_verified_at` alone) is never vouched for (JOIN-03 round 2, D1).
  // Sign-in rules read `phone_verified_at` and are unchanged. NULL for an
  // account that never proved a phone.
  phoneVerifiedFor String?          @map("phone_verified_for")
  // What the person does for a living, free text, as typed in the app.
  occupation       String?
  // 'user' | 'creator' (the Hub's AccountType), enforced in the application
  // layer like gender. NULL for rows that never said.
  accountType      String?          @map("account_type")

  // Cross-platform reference links (see Brief Section 2)
  onboardingRef       String? @map("onboarding_ref") @db.Uuid // -> onboarding_submissions.uuid
  wawuafricaAppUserId Int?    @map("wawuafrica_app_user_id") // -> WAWUAfrica users.id
  beautyUserId        Int?    @map("beauty_user_id") // -> WAWUBeauty users.id
  basketUserId        String? @map("basket_user_id") @db.Uuid // -> WAWUBasket users.id

  // Set when an account enters the cross-ecosystem deletion grace period
  // (status=pending_deletion); the hub finalizes ~48h later via the DELETE route.
  deletedAt     DateTime?           @map("deleted_at")

  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  refreshTokens    RefreshToken[]
  resetTokens      PasswordResetToken[]
  activationTokens ActivationToken[]
  phoneChangeRequests PhoneChangeRequest[]
  emailVerificationCodes EmailVerificationCode[]
  consents         Consent[]
  phoneVerification PhoneVerification?
  signupProgress   SignupProgress?
  signupEmailCode  SignupEmailCode?

  @@map("wawu_users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// The jti signed into the refresh token, the key a refresh or a sign-out
  /// finds this row by. NULL on rows stored before AUTH-08 (those tokens are
  /// matched by the old scan until they expire).
  jti       String?  @unique
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user WawuUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user WawuUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ActivationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user WawuUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("activation_tokens")
}

// Pending phone-number change awaiting email-OTP confirmation. The 6-digit code
// is stored hashed (argon2); `newPhone` is the number the user wants to switch
// to once they confirm. At most one pending request per user (the request step
// replaces any prior pending row). Mirrors the *Token models' shape.
model PhoneChangeRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  newPhone  String   @map("new_phone")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user WawuUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("phone_change_requests")
}

model OtpSession {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_sessions")
}

// A freshly generated 6-digit code emailed to confirm ownership of the
// address just used to register. Mirrors PhoneChangeRequest/OtpSession's
// shape exactly. No bypass exists (same principle as OtpService's own
// "there is deliberately NO OTP bypass" doc comment) -- every code is
// real, freshly generated, and delivered over the real (Resend) channel.
model EmailVerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user WawuUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}

// The pending sign-up phone code for one account: at most one row per user,
// and only POST /auth/signup creates it. The row is what makes an account a
// pending mobile sign-up: the phone routes act on no account without one.
// The code is stored hashed (argon2). Limits and durations live in
// src/auth/phone-verification.config.ts.
model PhoneVerification {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  phone           String
  codeHash        String   @map("code_hash")
  expiresAt       DateTime @map("expires_at")
  lastSentAt      DateTime @map("last_sent_at")
  // sha256 of the secret POST /auth/signup handed back for this attempt. The
  // phone routes need it with the phone, so a code only ever works in the
  // sign-up that asked for it.
  attemptHash     String   @unique @map("attempt_hash")
  // Set when the email on this sign-up is held, unproven, by another mobile
  // account: it is given to this account only if the person also enters the
  // code mailed to it. Until then the account has no email.
  claimEmail      String?  @map("claim_email")
  emailCodeHash   String?  @map("email_code_hash")
  // A sign-up that has not proven its phone by this time can no longer be
  // confirmed, and any new sign-up may take its email and phone.
  signupExpiresAt DateTime @map("signup_expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user WawuUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("phone_verifications")
}

// Wrong-code budget per PHONE NUMBER, not per code or per account row, so
// asking for a fresh code (or signing up again) never hands guesses back. A
// number nobody registered has a row too, which is what keeps the answer to
// "is this number registered" the same. `runCount` wrong codes in a row start
// a wait (`lockedUntil`); `dayCount` is the hard cap for the day.
model PhoneGuessBudget {
  phone       String    @id
  runCount    Int       @default(0) @map("run_count")
  lockedUntil DateTime? @map("locked_until")
  dayStart    DateTime  @map("day_start")
  dayCount    Int       @default(0) @map("day_count")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("phone_guess_budgets")
}

// Where a mobile sign-up stands after its phone code (AUTH-05). One row per
// account that proved its phone at sign-up (phone_verified_at set), made the
// first time its progress is asked for. Accounts without phone_verified_at
// (every web, legacy and phone-only account) never get one: they are not in
// the sign-up sequence at all. Each
// timestamp is a step done, in order: the email step (proven, or put off),
// then A11 for an earning account, or A12 and A13 for a discovering one.
// The steps and their order live in src/auth/signup-sequence.ts.
model SignupProgress {
  userId         String    @id @map("user_id") @db.Uuid
  // The email step was put off ("Later"). Proving the email (email_verified on
  // wawu_users) also completes it.
  emailSkippedAt DateTime? @map("email_skipped_at")
  creatorSetupAt DateTime? @map("creator_setup_at")
  interestsAt    DateTime? @map("interests_at")
  followsAt      DateTime? @map("follows_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user WawuUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("signup_progress")
}

// The code mailed to a signed-in mobile account to prove its email (AUTH-05).
// One row per account; a new code replaces the old. The code proves only the
// address it was sent to (`emailHash`, sha256 of it, so the row holds no
// address), and is dead once the account's email is no longer that address.
// The code is stored hashed (argon2).
model SignupEmailCode {
  userId     String   @id @map("user_id") @db.Uuid
  emailHash  String   @map("email_hash")
  codeHash   String   @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  lastSentAt DateTime  @map("last_sent_at")
  // Set when the code proved the email. The row stays until the next code,
  // so a repeat of the same confirm (a double tap) gets the same success.
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user WawuUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("signup_email_codes")
}

// Fixed-window counters shared by every instance: texts per client address,
// per phone, and per day overall (src/auth/rate-limiter.service.ts).
model RateCounter {
  scope       String
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@id([scope, key])
  @@map("rate_counters")
}

// A published version of a legal document (privacy, terms, …). The actual text
// lives on the canonical web page at `url`; this row is the version-of-record so
// every app/client reads one source and consent can be tracked per version.
// To publish an update: insert a new row (new version) — the current one is the
// published row with the latest effectiveDate.
model Policy {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String // 'privacy', 'terms', …
  version       String // e.g. '2026.06.01'
  title         String
  url           String // canonical web page rendering the full text
  effectiveDate DateTime @map("effective_date")
  summary       String? // optional changelog / what changed
  published     Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([slug, version])
  @@index([slug, published])
  @@map("policies")
}

// Immutable consent ledger: who accepted which policy version, when, from where.
// One row per acceptance — the audit trail for NDPA/NDPR and re-consent flows.
model Consent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  slug       String
  version    String
  source     String? // 'web' | 'wawubasket' | 'wawubeauty' | 'saf' | …
  ip         String?
  acceptedAt DateTime @default(now()) @map("accepted_at")

  user WawuUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, slug])
  @@index([slug, version])
  @@map("consents")
}
