# ── WAWU ID — environment variables ──────────────────────────────────────────
# Copy to .env and fill in real values. Every variable below is required.

# PostgreSQL connection string (provided by Railway after adding PostgreSQL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# RS256 keypair used to sign (private) and verify/publish via JWKS (public) JWTs.
# Store the full PEM. In a .env file, keep it on one line with newlines escaped as \n;
# in the Railway dashboard you can paste the multi-line PEM directly.
RS256_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
RS256_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# Access token lifetime (Brief Section 2: 15 minutes).
JWT_EXPIRES_IN=15m

# Refresh token lifetime (Brief Section 2: 30 days).
REFRESH_EXPIRES_IN=30d

# Shared secret required on internal service endpoints via the X-Service-Key header.
INTERNAL_SERVICE_KEY="generate-with: openssl rand -hex 32"

# ── OTP (WhatsApp Cloud API — Meta) ──────────────────────────────────────────
# System-user / app access token for the WhatsApp Cloud API.
WHATSAPP_TOKEN=
# The Phone Number ID of the WhatsApp Business number sending the OTP.
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version (optional; defaults to v21.0).
WHATSAPP_API_VERSION=v21.0
# Name of the WhatsApp message template used to send the OTP. This MUST be an
# approved Authentication-category template (optional; defaults to wawu_otp).
WHATSAPP_OTP_TEMPLATE=wawu_otp
# Template language code (optional; defaults to en).
WHATSAPP_OTP_LANG=en
# NOTE: There is intentionally NO OTP bypass in any environment. Every OTP is a
# real, freshly generated code delivered over WhatsApp (when configured) or
# email. Do not reintroduce a fixed-code bypass — it is an account-takeover hole.

# ── Email delivery (Resend) — emails skipped if RESEND_API_KEY is unset ──────
RESEND_API_KEY=
MAIL_FROM=WAWUAfrica <noreply@wawuafrica.com>

# Public base URL of this service, used to build reset/activation links.
APP_URL=https://wawu-id-production.up.railway.app

# Comma-separated list of allowed CORS origins (e.g. the hub frontend URL).
# Leave empty to allow all origins.
ALLOWED_ORIGINS=
WAWUAFRICA_API_URL=
